{
  "name": "newtrip_pseudo3d_base_workflow_template",
  "version": "0.1.0",
  "status": "template_requires_local_model_paths",
  "purpose": "Repeatable ComfyUI workflow template for NewTrip pseudo-3D pixel-art route layers.",
  "notes": [
    "This is a portable workflow spec, not a guaranteed one-click import for every ComfyUI installation.",
    "Replace checkpoint_name, lora_name, control_net_name, and reference image paths with installed local assets.",
    "Use the prompts and seeds from art-pipeline/comfyui/prompts/tutorial_coast_layer_prompts.yaml.",
    "For best consistency, add IPAdapter or equivalent style reference conditioning in your local ComfyUI graph."
  ],
  "locked_inputs": {
    "style_reference_image": "assets/art/reference/newtrip_style_reference_big_sur_pseudo3d_v1.png",
    "positive_prompt_source": "art-pipeline/comfyui/prompts/tutorial_coast_layer_prompts.yaml",
    "negative_prompt_source": "art-pipeline/comfyui/prompts/tutorial_coast_layer_prompts.yaml",
    "manifest": "art-pipeline/comfyui/manifests/tutorial_coast_v1.yaml"
  },
  "recommended_nodes": [
    {
      "group": "base",
      "nodes": [
        "CheckpointLoaderSimple",
        "CLIPTextEncode positive",
        "CLIPTextEncode negative",
        "EmptyLatentImage",
        "KSampler",
        "VAEDecode",
        "SaveImage"
      ]
    },
    {
      "group": "style_consistency",
      "nodes": [
        "LoraLoader",
        "IPAdapter or equivalent reference image conditioning"
      ]
    },
    {
      "group": "perspective_consistency",
      "nodes": [
        "LoadImage perspective guide",
        "ControlNetLoader",
        "ControlNetApply or equivalent"
      ]
    }
  ],
  "settings": {
    "width": 1024,
    "height": 1792,
    "steps": 32,
    "cfg": 6.5,
    "sampler_name": "dpmpp_2m_sde",
    "scheduler": "karras",
    "denoise": 1.0,
    "batch_size": 1,
    "seed_policy": "fixed_per_asset_from_manifest"
  },
  "replace_before_use": {
    "checkpoint_name": "REPLACE_WITH_PIXEL_ART_CAPABLE_SDXL_OR_FLUX_MODEL",
    "lora_name": "OPTIONAL_REPLACE_WITH_NEWTRIP_STYLE_LORA_WHEN_AVAILABLE",
    "control_net_name": "REPLACE_WITH_DEPTH_CANNY_OR_LINEART_CONTROLNET_FOR_SELECTED_MODEL",
    "save_prefix": "newtrip/tutorial_coast_v1"
  },
  "minimal_comfyui_api_prompt_shape": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "REPLACE_WITH_PIXEL_ART_CAPABLE_SDXL_OR_FLUX_MODEL"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "PASTE style_lock + camera_lock + route_context + selected layer prompt here",
        "clip": [
          "1",
          1
        ]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "PASTE global_negative here",
        "clip": [
          "1",
          1
        ]
      }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1024,
        "height": 1792,
        "batch_size": 1
      }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": 18422017,
        "steps": 32,
        "cfg": 6.5,
        "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras",
        "denoise": 1.0,
        "model": [
          "1",
          0
        ],
        "positive": [
          "2",
          0
        ],
        "negative": [
          "3",
          0
        ],
        "latent_image": [
          "4",
          0
        ]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "5",
          0
        ],
        "vae": [
          "1",
          2
        ]
      }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "newtrip/tutorial_coast_v1/tutorial_coast_road_base_001",
        "images": [
          "6",
          0
        ]
      }
    }
  }
}
